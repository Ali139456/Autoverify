# ---- Site ----
# Public URL of the deployed site (used for Stripe redirects, SEO & sitemap)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional — override homepage “Sample Report” links (defaults to /sample-report pages)
# NEXT_PUBLIC_SAMPLE_INSIGHTS_REPORT_URL=
# NEXT_PUBLIC_SAMPLE_INSIGHTS_PLUS_REPORT_URL=

# Coming soon mode is ON by default (non-live hosts). Set to false for local/preview full site.
# /vehicleinspections stays live either way.
NEXT_PUBLIC_COMING_SOON=
# autoverifi.com.au always shows Coming Soon until this is true (preview password still works).
NEXT_PUBLIC_SITE_LAUNCHED=
# Password-protected preview of the full site while coming soon is active
SITE_PREVIEW_PASSWORD=
# Optional extra secret for preview cookie signing
SITE_PREVIEW_SECRET=

# ---- Supabase (database) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose to the browser or commit to git
SUPABASE_SERVICE_ROLE_KEY=

# ---- Vehicle inspections (Base44) ----
# After Publish in Base44, paste your public *.base44.app URL here for 1:1 content.
# Leave blank to use the built-in native page (hero + services from Base44 preview).
NEXT_PUBLIC_BASE44_VEHICLE_INSPECTIONS_URL=

# ---- Stripe (payments) ----
# Leave blank to run in demo mode (reports unlock without payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Report prices in cents (AUD)
INSIGHTS_PRICE_CENTS=3500
INSIGHTS_PLUS_PRICE_CENTS=6500
# Optional — Stripe Promotion Code IDs (run: npx tsx scripts/setup-stripe-promo-codes.ts)
# STRIPE_PROMO_AVFREE=
# STRIPE_PROMO_AVCLUB=
REPORT_CURRENCY=aud
# Optional Stripe Price IDs (create products in Stripe Dashboard first)
STRIPE_INSIGHTS_PRICE_ID=
STRIPE_INSIGHTS_PLUS_PRICE_ID=

# ---- Autograb (vehicle data for Insights & Insights+) ----
# Docs: https://devhub.autograb.com
# Uses v2 registration, valuation predict/residual, market overlay, registration
# status, writeoff_info features, and PPSR (POST /v2/certificates/generate type ppsr).
# Leave blank to use built-in demo vehicle data
AUTOGRAB_API_KEY=
AUTOGRAB_BASE_URL=https://api.autograb.com.au/v2
# Optional comma list — only request overlay features your AutoGrab contract includes
# AUTOGRAB_REGISTRATION_FEATURES=build_data,performance_info,writeoff_info,extended_data,additional_upstream_data

# ---- Resend (purchase confirmation emails — optional) ----
RESEND_API_KEY=
RESEND_FROM=Auto Verifi <noreply@autoverifi.com.au>
# Optional — shown in purchase confirmation emails
AUTOVERIFI_COMPANY_NAME=Auto Verifi Pty Ltd
AUTOVERIFI_ABN=76 692 062 061
AUTOVERIFI_ADDRESS=Level 35, 100 Barangaroo Avenue, Sydney NSW 2000
AUTOVERIFI_SUPPORT_EMAIL=info@autoverifi.com.au

# ---- Twilio (SMS inspection links for Insights+) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Ravin.ai (Inspector Lite — Insights+ & predelivery inspections) ----
# Partner invite flow: getSignInToken + partnerInvite → inspector-lite URL
# Quote the value if it contains # (otherwise the rest of the line is treated as a comment)
RAVIN_API_KEY=
# Production: https://inspect.mtaus.ravin-ai.com — Beta: https://beta.mtaus.ravin-ai.com
RAVIN_BASE_URL=https://inspect.mtaus.ravin-ai.com
RAVIN_SITE_ID=49
RAVIN_PROVIDER=consumer
RAVIN_LINK_EXPIRED_IN=72
RAVIN_LOGIN_EXPIRED_IN=48
# Optional shared secret for POST /api/webhooks/ravin
RAVIN_WEBHOOK_SECRET=
# Legacy direct S3 upload (optional — only if Ravin provides credentials)
RAVIN_S3_UPLOAD_URL=https://ravin-eye-ingest.s3.amazonaws.com/
RAVIN_S3_ACCESS_KEY_ID=
RAVIN_S3_POLICY=
RAVIN_S3_SIGNATURE=
